# --- SENTINEL AI CONFIGURATION ---

# 🎥 Video Source
# 0 for webcam, "rtsp://..." for network camera, or "path/to/video.mp4"
VIDEO_SOURCE=0
TARGET_FPS=25
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# 🧠 Detection Settings
DETECTION_MODEL=yolov8n.pt
POSE_MODEL=yolov8n-pose.pt
DETECTION_CONFIDENCE=0.5
IOU_THRESHOLD=0.45
FORCE_CPU=false

# 🛡️ Anomaly Engine
LSTM_MODEL_PATH=models/action_lstm.pt
ANOMALY_THRESHOLD=0.7

# 📐 Zone Configuration
ZONES_FILE=backend/config/zones.json

# 💾 Performance & Storage
DB_PATH=data/events.db
CLIPS_DIR=data/clips
CLIP_DURATION=10

# 🌐 Server Settings
HOST=0.0.0.0
PORT=8000

# 📡 External Loggers (Optional)
WEBHOOK_URL=
EMAIL_ENABLED=false
