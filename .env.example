# --- SENTINEL AI CONFIGURATION ---
# Copy to .env and edit. Command-line flags (python backend/main.py --help) override these.

# Video source
# "demo" = bundled sample video (no camera needed), 0 = webcam,
# "rtsp://..." = network camera, or "path/to/video.mp4"
VIDEO_SOURCE=demo
LOOP_VIDEO=true
# Start with the demo footage running until the setting is first changed. The Docker image sets
# this (a container has no webcam); a laptop install starts with the webcam instead.
# DEMO_FOOTAGE=true
TARGET_FPS=25
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# Detection
DETECTION_MODEL=yolov8n.pt
POSE_MODEL=yolov8n-pose.pt
# Objects in Warehouse mode (YOLO-World, open vocabulary; next to the person tracker and pose).
# Changing the class list re-encodes the names once (CLIP); the result is cached in data/cache.
OBJECTS_ENABLED=true
OBJECT_MODEL=yolov8s-worldv2.pt
# Default (unset): the 80 COCO classes except person, plus pillow, cardboard box, ladder, hard hat,
# safety vest, forklift. Set a list to replace it:
# OBJECT_CLASSES=cardboard box,chair,couch,ladder,backpack,hard hat,safety vest,forklift
# Objects whose touch alerts ("Hand on knife (hazard)"):
HAZARD_CLASSES=tv,knife,scissors,oven,laptop
OBJECT_CONFIDENCE=0.3
# Per-class floors and extra prompts per class (the best-scoring prompt wins per object).
OBJECT_FLOORS=chair=0.25,cardboard box=0.25
# OBJECT_SYNONYMS={"chair": ["chair", "office chair", "gaming chair", "wooden chair"], "cardboard box": ["cardboard box", "shipping box", "carton"], "couch": ["couch", "sofa"]}
OBJECT_EVERY_N_FRAMES=1
DETECTION_CONFIDENCE=0.5
IOU_THRESHOLD=0.45
FORCE_CPU=false

# Anomaly engine (the LSTM stays disabled unless trained weights exist at this path)
LSTM_MODEL_PATH=models/action_lstm.pt
ANOMALY_THRESHOLD=0.7

# Zones (normalised 0-1 polygons)
ZONES_FILE=backend/config/zones.json

# Storage
DB_PATH=data/events.db
CLIPS_DIR=data/clips
CLIP_DURATION=10

# Server
HOST=0.0.0.0
PORT=8000
# Comma-separated origins allowed to call the REST API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Camera id recorded on every event (one pipeline = one camera)
CAMERA_ID=cam-0

# --- Notifications -------------------------------------------------------------
# At most one notification per (event type, person) within NOTIFY_DEBOUNCE_S seconds,
# and only for events at or above NOTIFY_MIN_SEVERITY (low | medium | high | critical).
NOTIFY_DEBOUNCE_S=60
NOTIFY_MIN_SEVERITY=medium

# Telegram: create a bot with @BotFather (token), message the bot once, then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates. Test: python scripts/send_test_alert.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email over SMTP (for Gmail: smtp.gmail.com, port 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients
SMTP_TO=
SMTP_STARTTLS=true
SMTP_SSL=false

# Optional webhook that receives every alert as JSON
WEBHOOK_URL=

# --- Search (plain-English questions about events) ------------------------------
# Only event details (type, zone, time, track, message) are sent to the provider; never
# images or clips. The LLM is never used per frame.
# nvidia (default): Nemotron via build.nvidia.com; anthropic: Claude via the Anthropic API.
LLM_PROVIDER=nvidia
# Empty = the provider's default: nvidia/nemotron-3-ultra-550b-a55b or claude-sonnet-5-5
LLM_MODEL=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
# Anthropic only: thinking effort (low | medium | high)
LLM_EFFORT=medium
# Model turns per question, token budget per question, questions per minute (all clients)
SEARCH_MAX_STEPS=6
SEARCH_MAX_TOKENS=60000
SEARCH_RATE_LIMIT_PER_MIN=10
# Allow /api/search from other machines on the network (default: this computer only)
ALLOW_REMOTE_SEARCH=false
