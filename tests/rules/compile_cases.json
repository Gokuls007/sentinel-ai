{
 "about": "Rule compiler eval (scripts/eval_rules.py). Zones: dock_1 Loading Dock (time_limited), lane Forklift Lane (one_way), chem Chemical Storage (restricted), gate Yard Gate (restricted). A case passes 'exact' when the compiled conditions (defaults filled in; 'loose' parameters ignored) and duration_s equal 'expect'; 'semantic' when they equal 'expect' or one of 'accept'. Refusal cases pass only if refused. Severity and notify are scored separately when given. Cases with source 'user' come from tests/rules/user_rules.md.",
 "zones": {
  "dock_1": [
   "Loading Dock",
   "time_limited"
  ],
  "lane": [
   "Forklift Lane",
   "one_way"
  ],
  "chem": [
   "Chemical Storage",
   "restricted"
  ],
  "gate": [
   "Yard Gate",
   "restricted"
  ]
 },
